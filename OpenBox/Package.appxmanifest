<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp uap3 rescap">

  <Identity
    Name="851Labs.openbox"
    Publisher="CN=openbox"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="34117904-7268-4355-b4ee-81d62d404222" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>openbox</DisplayName>
    <PublisherDisplayName>851 Labs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="OpenBox.App">
      <uap:VisualElements
        DisplayName="openbox"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="A homescreen of apps for Xbox Developer Mode."
        BackgroundColor="#111114">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#111114" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Web apps on the local network (a media server, say), and AirPlay later. -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Keep playing music when the console's home screen is opened. -->
    <uap3:Capability Name="backgroundMediaPlayback"/>
    <!-- Installing, finding, launching and uninstalling the store's package apps (Packages/). -->
    <rescap:Capability Name="packageManagement"/>
    <rescap:Capability Name="packageQuery"/>
  </Capabilities>
</Package>
