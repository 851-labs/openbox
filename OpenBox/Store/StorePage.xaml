<Page
    x:Class="OpenBox.Store.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBox.Store"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:ob="using:OpenBox.Controls"
    Background="{StaticResource ShellBackgroundBrush}">

    <Grid Padding="48,32,48,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Store" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Add apps to your homescreen. New apps are added by pull request at github.com/851-labs/openbox."
                FontSize="14" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="AppList" Grid.Row="1" Margin="-12,20,-12,0"
            SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:StoreItem">
                    <Grid Padding="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="56" CornerRadius="6" Background="{x:Bind App.Background}">
                            <Image Source="{x:Bind App.IconImage}" Width="36" Height="36" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind App.Name}" FontSize="18" />
                            <TextBlock Text="{x:Bind App.Description}" FontSize="13" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" Opacity="{x:Bind StatusOpacity, Mode=OneWay}"
                            FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <controls:ProgressRing x:Name="LoadingRing" IsActive="True" Width="32" Height="32" />
            <TextBlock x:Name="StatusText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Opacity="0.75" />
            <Button x:Name="RetryButton" Content="Retry" MinWidth="160" HorizontalAlignment="Center"
                Visibility="Collapsed" Click="RetryButton_Click" />
        </StackPanel>

        <ob:HintBar x:Name="Hints" Grid.Row="2" Margin="0,16,0,27" />
    </Grid>
</Page>
