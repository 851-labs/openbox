<Page
    x:Class="OpenBox.Spelunky.SpelunkyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ob="using:OpenBox.Controls"
    IsTabStop="True"
    Background="Black">

    <Grid Background="Black">
        <!-- The game shows here (spelunky.dll): a composition visual it puts its picture in. -->
        <Grid x:Name="Screen" />

        <!-- Before the game shows: its files downloading, or what went wrong. -->
        <Grid x:Name="StatusPanel" Background="{StaticResource ShellBackgroundBrush}" Padding="48,32,48,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Spacing="14">
                <Grid Width="132" Height="74" CornerRadius="8" Background="#FF8C5A2B" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Apps/spelunky.png" Width="44" Height="44" />
                </Grid>
                <TextBlock x:Name="Title" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                    TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Text="Spelunky Classic" />
                <TextBlock x:Name="Message" FontSize="16" Opacity="0.75" HorizontalAlignment="Center"
                    TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" Width="360" Maximum="1" Visibility="Collapsed" Margin="0,6,0,0" />
                <TextBlock x:Name="Details" FontSize="13" Opacity="0.5" HorizontalAlignment="Center"
                    TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <ob:HintBar x:Name="Hints" Grid.Row="1" Margin="0,16,0,27" />
        </Grid>
    </Grid>
</Page>
